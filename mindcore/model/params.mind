# Parameters: `param name = value | label=... step=... min=... max=... visible=false`.
# `group "Name"` sets the UI group for the params below it. min/max clamp the effective value after traits ran.

group "Cross-timescale coupling"
param speed_fast = 1 | label="FAST layer speed x" step=0.1
param speed_mid = 1 | label="MID layer speed x" step=0.1
param speed_slow = 1 | label="SLOW layer speed x" step=0.1
param carry_valence_to_mood = 0.4 | label="fast valence -> mood carry" step=0.05 min=0
param carry_phasic_to_arousal = 0.08 | label="fast arousal burst -> arousal carry" min=0
param carry_standards_to_selfesteem = 0.15 | label="standards impulse -> self esteem carry" step=0.05 min=0
param slow_follow_mood = 0.35 | label="mood baseline follows 24h mood" step=0.05 min=0
param slow_follow_arousal = 0.25 | label="arousal baseline follows 24h arousal" step=0.05 min=0
param mood_avg_hl = 1440 | label="24h average half-life (min)" step=60

group "Half-lives (min)"
param hl_phasic = 4 | label="phasic arousal" step=0.5
param hl_valence_reaction = 8 | label="valence reaction" step=0.5
param hl_threat = 10 | label="threat trace" step=0.5
param hl_surprise = 20 | label="surprise trace" step=1
param hl_adversity = 20 | label="adversity trace" step=1
param hl_recent_success = 30 | label="recent success" step=1
param hl_arousal_tonic = 60 | label="arousal (tonic)" step=5
param hl_mood = 360 | label="mood" step=10
param hl_dominance = 180 | label="dominance" step=10
param hl_standards = 720 | label="standards met" step=30
param hl_seeking = 90 | label="seeking" step=5
param hl_play = 120 | label="play" step=5
param hl_wanting = 45 | label="lust wanting" step=5
param hl_inhibition = 120 | label="lust inhibition" step=5
param hl_missing = 180 | label="missing user" step=10
param hl_commit = 15 | label="task commitment" step=1
param tau_boredom = 130 | label="boredom time constant" step=5
param hl_bond = 14400 | label="bond" step=500
param hl_competence = 2880 | label="competence" step=100
param hl_self_esteem = 20160 | label="self esteem" step=500
param hl_arousal_baseline = 2160 | label="arousal baseline" step=100
param hl_mood_baseline = 4320 | label="mood baseline" step=100

group "Impulse sizes"
param imp_phasic_novelty = 0.5 | label="arousal <- novelty" min=0
param imp_phasic_threat = 0.9 | label="arousal <- threat"
param imp_phasic_erotic = 0.4 | label="arousal <- erotic cue" min=0
param imp_phasic_goal = 0.2 | label="arousal <- |goal|"
param imp_phasic_anticipation = 0.3 | label="arousal <- anticipation"
param imp_val_goal = 0.15 | label="valence <- goal"
param imp_val_warm = 0.1 | label="valence <- warmth" min=0
param imp_val_standards = 0.1 | label="valence <- standards" min=0
param reunion_relief = 0.6 | label="valence <- reunion"
param impulse_cap = 0.8 | label="cap per step (latent)"
param impulse_budget = 1.5 | label="budget per hour (latent)" step=0.1
param appraisal_saturation = 3 | label="per-step saturation" step=0.1
param surprise_gain = 0.3 | label="surprise per novelty/failure" step=0.05

group "Conditioning"
param habituation_strength = 0.15 | label="habituation strength"
param habituation_half_life = 30 | label="habituation half-life" step=1
param mood_congruence = 0.3 | label="mood congruence"
param hormone_congruence = 0.2 | label="hormone congruence"
param missing_warmth_boost = 0.5 | label="warmth boost when missing" min=0
param intensity_bond = 1 | label="intense warmth bonds more" min=0

group "Freeform impulses"
param freeform_reference = 5 | label="reference (delta covering 76%)" step=0.5
param hammer_scale = 1 | label="hammer scale" step=0.1
param hammer_half_life = 30 | label="hammer recovery (min)" step=1

group "Gates and blunting"
param gate_floor_phasic = 0.1 | label="phasic gate floor"
param phasic_scale = 3 | label="phasic scale" step=0.1
param blunting = 1.2 | label="sleep-debt blunting" step=0.1
param rumination = 0.5 | label="rumination"
param giveup = 0.5 | label="give-up rate"

group "Controller master"
param ctl_on = 1 | label="controller on (1/0)" step=1
param demand_gain = 1.6 | label="task demand -> arousal" step=0.1

group "Controller: arousal"
param ctl_arousal_comfort = 0.6 | label="comfort level"
param ctl_arousal_drain = 0.4 | label="reserve drain / h"
param ctl_arousal_rec = 300 | label="recovery half-life (min)" step=10
param ctl_arousal_rebound = 2.5 | label="rebound depth" step=0.1
param ctl_arousal_shield = 0.8 | label="task shield" step=0.05
param ctl_arousal_deriv = 6 | label="derivative damping" step=0.5

group "Controller: seeking"
param ctl_seeking_comfort = 0.4 | label="comfort level"
param ctl_seeking_drain = 0.5 | label="reserve drain / h"
param ctl_seeking_rec = 240 | label="recovery half-life (min)" step=10
param ctl_seeking_rebound = 1.2 | label="rebound depth" step=0.1
param ctl_seeking_shield = 0.4 | label="task shield" step=0.05
param ctl_seeking_deriv = 3 | label="derivative damping" step=0.5

group "Controller: play"
param ctl_play_comfort = 0.3 | label="comfort level"
param ctl_play_drain = 0.5 | label="reserve drain / h"
param ctl_play_rec = 240 | label="recovery half-life (min)" step=10
param ctl_play_rebound = 1 | label="rebound depth" step=0.1
param ctl_play_shield = 0 | label="task shield" step=0.05
param ctl_play_deriv = 2 | label="derivative damping" step=0.5

group "Controller: lust_wanting"
param ctl_lust_wanting_comfort = 0.3 | label="comfort level"
param ctl_lust_wanting_drain = 0.8 | label="reserve drain / h"
param ctl_lust_wanting_rec = 180 | label="recovery half-life (min)" step=10
param ctl_lust_wanting_rebound = 1.2 | label="rebound depth" step=0.1
param ctl_lust_wanting_shield = 0 | label="task shield" step=0.05
param ctl_lust_wanting_deriv = 2 | label="derivative damping" step=0.5

group "Controller: dominance"
param ctl_dominance_comfort = 0.55 | label="comfort level"
param ctl_dominance_drain = 0.3 | label="reserve drain / h"
param ctl_dominance_rec = 360 | label="recovery half-life (min)" step=10
param ctl_dominance_rebound = 1 | label="rebound depth" step=0.1
param ctl_dominance_shield = 0.6 | label="task shield" step=0.05
param ctl_dominance_deriv = 2 | label="derivative damping" step=0.5

group "Strain and spillover"
param strain_threshold = 0.75 | label="arousal strain threshold"
param strain_gain = 1.5 | label="arousal strain gain" step=0.1
param strain_hl = 720 | label="arousal strain half-life" step=30
param strain_to_baseline = 0.35 | label="strain -> arousal baseline"
param mood_strain_threshold = 0.4 | label="low-mood strain threshold"
param mood_strain_gain = 1 | label="low-mood strain gain" step=0.1
param mood_strain_to_baseline = 0.6 | label="strain -> mood baseline"
param spill_arousal = 0.15 | label="spill phasic -> arousal baseline"
param spill_mood = 0.1 | label="spill reaction -> mood baseline"
param spill_debt = 0.002 | label="spill wake -> sleep debt" step=0.001
param spill_daily_cap = 0.6 | label="spill daily cap (latent)" step=0.05

group "Drives and targets"
param boredom_rate = 0.8 | label="boredom build rate" min=0
param reunion_keep = 0.4 | label="missing kept after reunion"
param missing_ramp = 2 | label="missing ramp" step=0.1 min=0
param detach_start = 4320 | label="detachment starts (min)" step=60
param detach_tau = 2880 | label="detachment time constant" step=60
param bond_baseline = 0.45 | label="bond baseline"
param circ_arousal = 0.7 | label="circadian -> arousal" step=0.05
param sleep_pressure_arousal = 1.4 | label="sleep pressure -> arousal" step=0.05
param ultradian_amp = 0.08 | label="ultradian amplitude"
param weather_mood = 0.15 | label="weather -> mood"
param mood_baseline_offset = 0.25 | label="mood baseline offset"
param bistable = 0 | label="mood bistability" min=0
param wanting_deprivation = 0.3 | label="wanting <- time since warmth" step=0.05
param deprivation_scale = 2880 | label="deprivation time scale (min)" step=60

group "Body and clock"
param tau_wake = 1092 | label="wake time constant (min)" step=30
param tau_sleep = 252 | label="sleep time constant (min)" step=10
param load_fatigue = 0.0015 | label="load -> fatigue" step=0.0005
param stress_fatigue = 0.0008 | label="stress -> fatigue" step=0.0005
param light_fatigue = 0.3 | label="dark -> fatigue"
param moon_sleep = 0.3 | label="moon -> sleep"
param clock_anchor = 15 | label="clock anchor (h)" step=0.5
param clock_period = 24 | label="clock period (h)" step=0.1
param phase_gain = 0.0015 | label="phase shift gain" step=0.0005
param anchor_pull = 0.01 | label="anchor pull" step=0.005
param sleep_threshold = -0.3 | label="sleep threshold" step=0.05
param sleep_standards_boost = 1 | label="sleep heals standards" step=1

group "Environment"
param lat = 48.2 | label="latitude" step=0.5
param start_doy = 278 | label="start day of year" step=1
param cloud = 0.4 | label="cloud cover" step=0.05
param pressure = 1013 | label="pressure (hPa)" step=1
param weather_swing = 0 | label="pressure swing (hPa)" step=1
param moon_on = 1 | label="moon effect" step=0.1
param moon_phase0 = 5 | label="lunar age at start (d)" step=0.5

group "Persona (cycle timing)"
param cycle_alpha = 0 | label="cycle strength (0 = off; set by trait Menstrual cycle)" step=0.1 min=0
param cycle_length = 28 | label="cycle length (days)" step=1
param cycle_start_day = 3 | label="cycle day at start" step=1

group "Trait hooks (advanced)"
param tb_arousal = 0 | label="arousal target bias (logit)" step=0.1
param tb_mood = 0 | label="mood target bias" step=0.1
param tb_dom = 0 | label="dominance target bias (logit)" step=0.1
param tb_seek = 0 | label="seeking target bias (logit)" step=0.1
param tb_play = 0 | label="play target bias (logit)" step=0.1
param tb_want = 0 | label="wanting target bias (logit)" step=0.1
param tb_inh = 0 | label="inhibition target bias (logit)" step=0.1
param tb_bond = 0 | label="bond target bias (logit)" step=0.1
param tb_comp = 0 | label="competence target bias (logit)" step=0.1
param tb_self = 0 | label="self esteem target bias (logit)" step=0.1
param imp_gain = 1 | label="all appraisal impulses x" step=0.1
param lust_mul = 1 | label="LUST gate x" step=0.1
param cyc_amp = 0 | label="spontaneous mood cycle amplitude" step=0.05 min=0
param cyc_days = 6 | label="spontaneous cycle period (days)" step=0.5
param floor_bond = 0 | label="FLOOR bond (0 = off)" step=0.05
param floor_comp = 0 | label="FLOOR competence (0 = off)" step=0.05
param floor_self = 0 | label="FLOOR self esteem (0 = off)" step=0.05
param floor_dom = 0 | label="FLOOR dominance (0 = off)" step=0.05
param floor_mood = 0 | label="FLOOR mood and baseline (0 = off)" step=0.05
param cap_inh = 1 | label="CAP lust inhibition (1 = off)" step=0.05 min=0.03

group "Top-level"
param lust_gate = 1 | label="LUST impulse gate (0-1)" step=0.1
